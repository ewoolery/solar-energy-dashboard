TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:8000/callback
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_API_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
DATABASE_PATH=energy.sqlite3
TIMEZONE=America/Los_Angeles
# Background poller interval in seconds (0 = off; a headless deploy sets ~600).
SAMPLE_INTERVAL_SECONDS=0
# ntfy.sh push when the Powerwall hits full. Blank topic = disabled. Use a
# long, hard-to-guess topic and subscribe to it in the ntfy phone app.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
BATTERY_FULL_PCT=99.5
BATTERY_REARM_PCT=95

