[Unit]
Description=Tesla Energy Dashboard (read-only Powerwall/solar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set User and the paths below to match your Pi (and deploy.sh APP_DIR).
User=pi
WorkingDirectory=/home/pi/tesla-energy-dashboard
# .env in WorkingDirectory is loaded by python-dotenv at startup.
ExecStart=/home/pi/tesla-energy-dashboard/.venv/bin/uvicorn home_energy_dashboard.app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
